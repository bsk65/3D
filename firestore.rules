rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // "Del resultater": afgør om viewerUid har en godkendt (accepteret)
    // shareRequests-relation til ownerUid, OG at runden er afsluttet EFTER selve
    // godkendelsen (acceptedAt) — så en ny deling ikke automatisk giver adgang
    // til hele ejerens historik, kun runder skudt fra godkendelsestidspunktet.
    // acceptedAt findes ikke på shareRequests-dokumenter fra før dette felt blev
    // tilføjet; der falder vi tilbage til updatedAt, som acceptShareRequest i
    // js/sharing.js altid sætter til selve godkendelsestidspunktet.
    // Funktionerne står her (inde i match-blokken) fordi $(database) kun er
    // bundet inden for denne blok — uden for den løser $(database) ikke til
    // den rigtige værdi.
    function shareAcceptedAtMillis(ownerUid, viewerUid) {
      let r = get(/databases/$(database)/documents/shareRequests/$(ownerUid + '_' + viewerUid)).data;
      return ('acceptedAt' in r ? r.acceptedAt : r.updatedAt).toMillis();
    }
    function canViewSharedRound(ownerUid, viewerUid, completedMillis) {
      return exists(/databases/$(database)/documents/shareRequests/$(ownerUid + '_' + viewerUid)) &&
        get(/databases/$(database)/documents/shareRequests/$(ownerUid + '_' + viewerUid)).data.status == 'accepteret' &&
        completedMillis is number &&
        completedMillis > shareAcceptedAtMillis(ownerUid, viewerUid);
    }
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
      match /{subcol}/{docId} {
        allow read, write: if request.auth.uid == uid;
        match /{sub2}/{doc2} {
          allow read, write: if request.auth.uid == uid;
        }
      }
      // Tillad en medskytte at "levere" en fælles runde ind i denne brugers
      // rounds-samling, men kun som ny runde (create) og kun hvis medskytten
      // OG målbrugeren (uid) begge står opført som skytte i selve runde-dataen.
      match /rounds/{roundId} {
        allow create: if request.auth != null &&
          request.auth.uid != uid &&
          request.resource.data.shooterIds is list &&
          request.auth.uid in request.resource.data.shooterIds &&
          uid in request.resource.data.shooterIds;
        // "Del resultater": en godkendt seer (accepteret shareRequests-dokument,
        // se nedenfor) må læse ejerens runder afsluttet efter godkendelsen —
        // se canViewSharedRound ovenfor. Kombineres via OR med ejerens egen
        // adgang fra den generiske {subcol}/{docId}-regel ovenfor.
        allow read: if request.auth != null &&
          canViewSharedRound(uid, request.auth.uid, resource.data.completed);
      }
    }
    match /courses/{courseId} {
      allow read: if request.auth != null &&
        (resource.data.hidden != true
         || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
         || (request.auth.token.email != null && resource.data.approvedUsers.hasAny([request.auth.token.email.lower()])));
      allow write: if exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null;
      // Kun den ene hardkodede super-admin må styre admin-listen (matcher
      // state.isSuperAdmin-tjekket i js/app-init.js). Uden dette kunne enhver
      // almindelig admin udnævne/fjerne andre admins, inkl. super-adminen selv.
      allow write: if request.auth.token.email == 'bsklausen@proton.me';
    }
    match /meetups/{meetupId} {
      // "Skal vi skyde sammen": opretteren inviterer altid eksplicit
      // (invitedUids) — der findes ingen "helt åben, ingen invitation"-tilstand.
      allow read: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         request.auth.uid in resource.data.invitedUids ||
         request.auth.token.email == 'bsklausen@proton.me');
      allow create: if request.auth != null &&
        request.resource.data.creatorUid == request.auth.uid &&
        request.resource.data.invitedUids is list &&
        request.resource.data.status == 'åben';
      allow update: if request.auth != null &&
        (resource.data.creatorUid == request.auth.uid ||
         request.auth.uid in resource.data.invitedUids) &&
        request.resource.data.creatorUid == resource.data.creatorUid &&
        request.resource.data.invitedUids == resource.data.invitedUids;
      // Kun opretteren kan slette en aftale permanent (fx en fejloprettet eller
      // aflyst aftale man ikke vil have liggende). Ellers forsvinder aftaler
      // automatisk via Firestore TTL-policy på expireAt-feltet (sættes op
      // separat i Firebase Console) når den planlagte dato er passeret.
      allow delete: if request.auth != null && resource.data.creatorUid == request.auth.uid;
    }
    // "Del resultater": anmodning om at måtte se en vens færdige runder.
    // Deterministisk dokument-id ownerUid_viewerUid gør adgangstjekket i
    // users/{uid}/rounds ovenfor muligt via get()/exists() uden ekstra query.
    match /shareRequests/{reqId} {
      allow read: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid || resource.data.viewerUid == request.auth.uid);
      allow create: if request.auth != null &&
        reqId == request.resource.data.ownerUid + '_' + request.resource.data.viewerUid &&
        request.resource.data.viewerUid == request.auth.uid &&
        request.resource.data.ownerUid != request.auth.uid &&
        request.resource.data.status == 'afventer';
      // Kun ejeren må acceptere/afvise/afslutte. Undtagelsen lader seeren selv
      // gensende en anmodning ('afvist' → 'afventer') efter en afvisning —
      // ellers ville et afvist forhold være en permanent spærring.
      allow update: if request.auth != null &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        request.resource.data.viewerUid == resource.data.viewerUid &&
        (resource.data.ownerUid == request.auth.uid ||
         (resource.data.viewerUid == request.auth.uid &&
          resource.data.status == 'afvist' && request.resource.data.status == 'afventer'));
      // Ejeren sletter for at afslutte delingen; seeren sletter for at
      // fortryde egen (typisk afventende) anmodning.
      allow delete: if request.auth != null &&
        (resource.data.ownerUid == request.auth.uid || resource.data.viewerUid == request.auth.uid);
    }
    match /bane_stats/{courseId}/runder/{roundId} {
      allow read: if request.auth != null &&
        (!exists(/databases/$(database)/documents/courses/$(courseId))
         || get(/databases/$(database)/documents/courses/$(courseId)).data.hidden != true
         || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
         || (request.auth.token.email != null && get(/databases/$(database)/documents/courses/$(courseId)).data.approvedUsers.hasAny([request.auth.token.email.lower()])));
      // Dokumenterne er anonyme (intet ejer-felt), og roundId er et forudsigeligt
      // Date.now()-baseret ID — derfor må write ikke tillade vilkårlig
      // overskrivning/sletning. create er stadig åben (crowd-sourced anonym
      // statistik); delete kræver at brugeren selv har rundens ID i sin egen
      // rounds-samling (proxy for ejerskab, jf. results.js' egen-runde-sletning).
      allow create: if request.auth != null;
      allow update: if false;
      allow delete: if request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/rounds/$(roundId));
    }
    // Collection-group-forespørgsel på tværs af ALLE baners 'runder' (bruges af
    // "Brug af appen"-statistikken i admin-panelet, js/admin.js loadUsageStats).
    // Firestore anvender kun ovenstående regel ved læsning af én banes egen
    // runder-samling — en collection group-forespørgsel kræver {path=**}, derfor
    // dette separate, admin-only rule-block.
    match /{path=**}/runder/{roundId} {
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
  }
}
